# Tracker detector: Bluetooth LE observer (NimBLE), no WiFi

# Bluetooth LE only, NimBLE host (smaller than Bluedroid). All roles stay
# enabled: NimBLE of ESP-IDF 5.4.0 does not build with central/peripheral off
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
# Keep up with busy places (train stations, airports)
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_CTRL_BLE_SCAN_DUPL=n

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
