# ESP-IDF Configuration for WiFi Repeater with NAPT
# Enable IP forwarding and NAPT (NAT)
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# WiFi Configuration
# Block-ack windows of 16 (default 6) let more frames go out per transmission;
# static RX buffers >= RX window as recommended in the ESP-IDF Kconfig help
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_WIFI_RX_BA_WIN=16

# Performance (based on the ESP-IDF iperf example for ESP32-S3)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# Packet forwarding path (lwIP) runs from IRAM instead of flash
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
# NAPT and WireGuard encryption run in the TCP/IP task - on core 1, WiFi stays on core 0
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y

# Increase main task stack size for display operations
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Enable console for debugging
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Web server: captive portal probes (e.g. iOS) send long headers
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# More sockets for web server + captive DNS + connectivity probe
CONFIG_LWIP_MAX_SOCKETS=16

# WireGuard crypto (handshake) runs in the TCP/IP task
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=6144

# WireGuard: makes esp_netif keep its pointer in netif->client_data instead of
# netif->state, which the WireGuard interface uses for its own data
# (same workaround as ESPHome, see trombik/esp_wireguard#33)
CONFIG_LWIP_PPP_SUPPORT=y

# 1500K app partition - the firmware no longer fits in 1M
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
